// Fyx's default settings, layered over Zed's `default.json` when Fyx starts
// (`crates/zed/src/zed/fyx.rs`, called from `main.rs`). Only the values that
// differ from Zed's defaults live here; `default.json` stays as upstream ships
// it, so rebases do not conflict and upstream tests keep Zed's defaults.
//
// Objects are merged key by key: to turn off an entry Zed enables, set it to
// `false` rather than removing it.
{
  // No requests to zed.dev. Every Zed cloud URL (sign-in, collaboration, the
  // extension registry, telemetry upload, update checks) is derived from this
  // value; port 0 on loopback fails before a packet is sent. Set it to
  // "https://zed.dev" in your settings to use Zed's services (their terms
  // apply). The ZED_SERVER_URL environment variable still overrides it.
  "server_url": "http://127.0.0.1:0",
  // No telemetry: Fyx has no endpoint for it.
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  // No update feed yet.
  "auto_update": false,
  // No zed.dev account, so no sign-in button, onboarding banners or
  // collaboration panel.
  "title_bar": {
    "show_sign_in": false,
    "show_onboarding_banner": false,
  },
  "collaboration_panel": {
    "button": false,
  },
  // The "zed" edit prediction provider needs a zed.dev account. Bring your own
  // provider instead (see `edit_predictions.provider`).
  "edit_predictions": {
    "provider": "none",
  },
  // Fyx does not use Zed's extension registry by default, so nothing to
  // auto-install or suggest from it.
  "auto_install_extensions": {
    "html": false,
  },
  "suggest_extensions": false,
  // Review agent edits hunk by hunk before they land (`crates/agent_review`). Also in the
  // agent panel's options menu; the FYX_AGENT_REVIEW environment variable overrides it.
  "agent_review": {
    "enabled": false,
  },
  // No avatar lookups: they send commit author emails to GitHub and repository SHAs to other
  // forges.
  "git": {
    "blame": {
      "show_avatar": false,
    },
  },
  // Prettier for JSON-with-comments (settings and keymap files) would `npm install` on first
  // open; the JSON language server formats them instead.
  "languages": {
    "JSONC": {
      "prettier": {
        "allowed": false,
      },
    },
  },
  // The agent's default model is a bring-your-own-key provider, not Zed's hosted models
  // (zed.dev). Set an Anthropic API key, or pick any other configured provider.
  "agent": {
    "default_model": {
      "provider": "anthropic",
      "model": "claude-sonnet-5-5",
    },
  },
  // Security modes for agents (`crates/fyx_guard`, docs/fyx/security-modes.md).
  // "off" behaves like Zed; "audit" logs what "shield" would block; "shield"
  // keeps private files, secret environment variables and agent configs out of
  // agents' reach. Only user settings set it; while Fyx runs, a change that
  // lowers it asks for confirmation.
  "fyx_security": {
    "mode": "off",
    "allow_env": [],
  },
  "fyx": {
    "extensions": {
      // Folders of UI extensions in development, loaded on every start and reloaded when
      // rebuilt ("fyx_ui: install dev UI extension" adds to it). Each needs one "Enable".
      "dev_paths": [],
      // Show the Extension Inspector panel in release builds too (dev builds always have it).
      "developer_mode": false,
      // Status bar items of UI extensions not to show, as "<extension id>/<surface id>"
      // (right-click an item, "Hide Button").
      "hidden_status_items": [],
      // The Fyx extension registry (https://, http://localhost or file://). Empty: off.
      "registry_url": "",
      "network": {
        // Host names UI extensions may reach on your private network (10/8, 172.16/12,
        // 192.168/16, 100.64/10, fc00::/7) when they also declare them; "*.corp.example"
        // matches subdomains. Loopback and link-local addresses are never allowed.
        "private_hosts": [],
      },
    },
  },
}
