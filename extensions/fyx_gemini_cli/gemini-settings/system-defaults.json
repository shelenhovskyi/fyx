{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "name": "fyx-session-start",
            "command": "node -e \"const relay=process.env.FYX_RELAY;if(relay){const run=require('child_process').spawnSync(relay,process.argv.slice(1),{stdio:'inherit'});process.exit(run.status===null?0:run.status)}\" -- --channel fyx-gemini-cli/session-start",
            "timeout": 10000
          }
        ]
      }
    ],
    "BeforeAgent": [
      {
        "hooks": [
          {
            "type": "command",
