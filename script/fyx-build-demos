#!/usr/bin/env bash
# Builds the Fyx demo UI extensions for wasm32-wasip2 and copies each component next to its
# extension.toml as fyx_ui.wasm, so each demo directory loads as a UI extension.
# Usage: script/fyx-build-demos [--release] [--fyx-ui-0-2 | --fyx-ui-0-3 | --fyx-ui-0-4]
# [extra cargo build args, e.g. -j 2]
#
# --fyx-ui-0-2 builds every demo's fyx:ui 0.2 world (its `fyx-ui-0-2` feature) instead, for a dev
# build whose host runs 0.2. It leaves the repository alone: each demo goes to
# <target>/fyx-demos-v0_2/<demo>/, with fyx_ui.wasm, a copy of extension.toml whose api_version
# is 0.2.0, and a copy of every folder of the demo but src/ (assets/, and the package files that
# `${package}` names in 0.4). The 0.2 builds use the target directory
# <target>/fyx-demos-v0_2/target, so they do not overwrite the 0.1 ones.
# --fyx-ui-0-3 does the same for the staged 0.3 world (`fyx-ui-0-3`, api_version 0.3.0) in
# <target>/fyx-demos-v0_3/, and --fyx-ui-0-4 for the staged 0.4 world (`fyx-ui-0-4`, api_version
# 0.4.0) in <target>/fyx-demos-v0_4/; dev builds run staged worlds. Each staged mode also builds
# the demos that exist only from that world on (their manifest names it).
#
# Each world takes its own capabilities (the host's `UiManifest::check_world`). A manifest line
# `# fyx-ui-0-2: capabilities = [...]` replaces the `capabilities` line in the 0.2 and later
# copies, `# fyx-ui-0-3: ...` in the 0.3 and 0.4 copies, and `# fyx-ui-0-4: ...` in the 0.4 copy;
# the repository's manifest stays the 0.1 one. Any other `# fyx-ui-0-N: <line>` becomes <line>,
# in place, in the 0.N and later copies: a key only newer worlds accept, such as the `reason` that
# 0.4 requires on `[fyx_ui.network]` and `[[fyx_ui.processes]]`.
#
# Then point the dev build at the directories it prints, e.g. on Windows:
#   set FYX_UI_DEV_EXTENSIONS=<repo>\extensions\fyx_demo_counter;<repo>\extensions\fyx_demo_todo;...
# FYX_UI_DEV_EXTENSIONS, and the staged worlds, work only in a build on the Dev or Nightly
# release channel (crates/zed/RELEASE_CHANNEL is "dev" in the repository). An older build on the
# Stable channel ignores them: start it with ZED_RELEASE_CHANNEL=dev set as well.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

demos=(fyx_demo_counter fyx_demo_todo fyx_demo_gallery fyx_demo_markdown fyx_demo_gitstatus fyx_demo_form fyx_demo_decorations fyx_demo_images fyx_demo_charts)
profile=debug
# The world to build: empty for the default 0.1, or 0_2 / 0_3.
world=""
cargo_args=()
while [[ $# -gt 0 ]]; do
    case "$1" in
        --release)
            profile=release
            cargo_args+=(--release)
            shift
            ;;
        --fyx-ui-0-2 | --fyx-ui-0-3 | --fyx-ui-0-4)
            if [[ -n "$world" ]]; then
                echo "fyx-build-demos: pass at most one of --fyx-ui-0-2, --fyx-ui-0-3 and --fyx-ui-0-4" >&2
                exit 1
            fi
            world=${1#--fyx-ui-}
            world=${world/-/_}
            shift
            ;;
        *) break ;;
    esac
done
# Demos that exist only from a staged world on (their manifest says that api_version).
if [[ "$world" == "0_3" || "$world" == "0_4" ]]; then
    demos+=(fyx_demo_t2)
fi
if [[ "$world" == "0_4" ]]; then
    demos+=(fyx_demo_pseudo_terminal fyx_demo_terminal_profiles fyx_claude_code fyx_gemini_cli)
fi
for demo in "${demos[@]}"; do
    cargo_args+=(-p "$demo")
    if [[ -n "$world" ]]; then cargo_args+=(--features "$demo/fyx-ui-${world/_/-}"); fi
done

# Honors CARGO_TARGET_DIR and .cargo/config.toml; JSON escapes Windows backslashes, so turn
# them into forward slashes, which Git Bash accepts.
target_dir=$(
    cargo metadata --format-version 1 --no-deps \
        | sed -n 's/.*"target_directory":"\([^"]*\)".*/\1/p' \
        | sed 's#\\\\#/#g'
)
if [[ -z "$target_dir" ]]; then
    echo "fyx-build-demos: could not read the target directory from cargo metadata" >&2
    exit 1
fi

out_root=""
build_dir="$target_dir"
if [[ -n "$world" ]]; then
    out_root="$target_dir/fyx-demos-v$world"
    build_dir="$out_root/target"
    cargo_args+=(--target-dir "$build_dir")
fi

cargo build --target wasm32-wasip2 "${cargo_args[@]}" "$@"

# The manifest for one world: the newest `# fyx-ui-0-N: capabilities = ...` line for N up to
# that world, in place of the `capabilities` line, and the other markers up to that world as
# plain lines.
world_manifest() {
    local manifest=$1 world=$2 markers line
    case "$world" in
        0_4) markers=("fyx-ui-0-4" "fyx-ui-0-3" "fyx-ui-0-2") ;;
        0_3) markers=("fyx-ui-0-3" "fyx-ui-0-2") ;;
        *) markers=("fyx-ui-0-2") ;;
    esac
    line=""
    for marker in "${markers[@]}"; do
        line=$(sed -n "s/^# $marker: \(capabilities = .*\)\$/\1/p" "$manifest")
        if [[ -n "$line" ]]; then break; fi
    done
    # `0_4` -> 4. A `# fyx-ui-0-N: <line>` marker that is not a capabilities line is kept as
    # <line> when N is at most the world built; without markers the manifest is copied as it is.
    awk -v line="$line" -v world="${world#0_}" '
        /^capabilities = / && line != "" { print line; next }
        /^# fyx-ui-0-[0-9]+: / {
            minor = $0; sub(/^# fyx-ui-0-/, "", minor); sub(/:.*/, "", minor)
            text = $0; sub(/^# fyx-ui-0-[0-9]+: /, "", text)
            if (text !~ /^capabilities = / && minor + 0 <= world + 0) print text
            next
        }
        { print }' "$manifest"
}

separator=":"
dirs=()
for demo in "${demos[@]}"; do
    component="$build_dir/wasm32-wasip2/$profile/$demo.wasm"
    if [[ -n "$world" ]]; then
        version="${world/_/.}.0"
        dir="$out_root/$demo"
        mkdir -p "$dir"
        cp "$component" "$dir/fyx_ui.wasm"
        # Every folder but src/: assets/ and the package files `${package}` names.
        for folder in "extensions/$demo"/*/; do
            name=$(basename "$folder")
            if [[ "$name" == "src" ]]; then continue; fi
            rm -rf "${dir:?}/$name"
            cp -R "extensions/$demo/$name" "$dir/$name"
        done
        # The repository's manifests name 0.1.0, or the world a demo needs; a demo is only built
        # for that world or a newer one, so the copy always names the world built.
        world_manifest "extensions/$demo/extension.toml" "$world" \
            | sed "s/^api_version = \"0\\.[0-9]*\\.0\"\$/api_version = \"$version\"/" \
            > "$dir/extension.toml"
        if ! grep -q "^api_version = \"$version\"\$" "$dir/extension.toml"; then
            echo "fyx-build-demos: extensions/$demo/extension.toml has no api_version = \"0.N.0\" line" >&2
            exit 1
        fi
    else
        dir="$PWD/extensions/$demo"
        cp "$component" "$dir/fyx_ui.wasm"
    fi
    echo "fyx-build-demos: $component -> $dir/fyx_ui.wasm"
    if command -v cygpath >/dev/null 2>&1; then
        dir=$(cygpath -w "$dir")
        separator=";"
    fi
    dirs+=("$dir")
done

joined=$(IFS="$separator"; echo "${dirs[*]}")
echo "FYX_UI_DEV_EXTENSIONS=$joined"
echo "fyx-build-demos: Dev and Nightly builds read it; for a Stable-channel build also set ZED_RELEASE_CHANNEL=dev" >&2
