#!/usr/bin/env python3
"""Workspace packages for a FAST gate: those with files changed since BASE, plus every workspace
package that depends on one of them (normal, dev or build dependency, transitively), limited to
the packages Fyx changed since UPSTREAM, the set a FULL gate tests. So FAST is never larger than
FULL: a change to settings_content does not pull in upstream crates Fyx never touched.

Usage: script/fyx-gate-crates BASE UPSTREAM
Prints one package name per line. Never selects crates/collab (server-only, not built by Fyx).
Reads `cargo metadata` (offline, locked), so it sees the dependency graph cargo builds.
"""

import json
import os
import subprocess
import sys
from collections import defaultdict, deque


def main() -> int:
    if len(sys.argv) != 3:
        print(__doc__.strip(), file=sys.stderr)
        return 2
    base, upstream = sys.argv[1], sys.argv[2]
    root = subprocess.check_output(["git", "rev-parse", "--show-toplevel"], text=True).strip()

    def changed_since(ref):
        return subprocess.check_output(
            ["git", "diff", "--name-only", f"{ref}...HEAD", "--", "crates", "extensions"],
            text=True,
            cwd=root,
        ).split()

    metadata = json.loads(
        subprocess.check_output(
            ["cargo", "metadata", "--format-version", "1", "--locked", "--offline"],
            cwd=root,
        )
    )
    members = set(metadata["workspace_members"])
    packages = {p["id"]: p for p in metadata["packages"] if p["id"] in members}

    # Package directory (relative, forward slashes) -> package id.
    by_dir = {}
    for package_id, package in packages.items():
        directory = os.path.relpath(os.path.dirname(package["manifest_path"]), root)
        by_dir[directory.replace(os.sep, "/")] = package_id

    def packages_of(paths):
        found = set()
        for path in paths:
            parts = path.split("/")
            if len(parts) >= 2 and "/".join(parts[:2]) in by_dir:
                found.add(by_dir["/".join(parts[:2])])
        return found

    seeds = packages_of(changed_since(base))
    fyx_changed = packages_of(changed_since(upstream))

    dependents = defaultdict(set)
    for node in metadata["resolve"]["nodes"]:
        if node["id"] not in members:
            continue
        for dep in node["deps"]:
            if dep["pkg"] in members:
                dependents[dep["pkg"]].add(node["id"])

    selected = set(seeds)
    queue = deque(seeds)
    while queue:
        for dependent in dependents[queue.popleft()]:
            if dependent not in selected:
                selected.add(dependent)
                queue.append(dependent)

    names = sorted(
        packages[package_id]["name"]
        for package_id in selected & fyx_changed
        if not packages[package_id]["manifest_path"].replace(os.sep, "/").endswith(
            "crates/collab/Cargo.toml"
        )
    )
    print("\n".join(names))
    return 0


if __name__ == "__main__":
    sys.exit(main())
