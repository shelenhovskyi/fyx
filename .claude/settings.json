{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash", "Edit", "Write", "NotebookEdit", "WebFetch", "WebSearch",
      "PowerShell(cargo check:*)",
      "PowerShell(cargo nextest:*)",
      "PowerShell(cargo fmt:*)",
      "PowerShell(./script/clippy.ps1:*)",
      "PowerShell(script/clippy.ps1:*)",
      "PowerShell(bash script/gate.sh:*)",
      "PowerShell(bash ./script/gate.sh:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push --force-if-includes:*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f *)",
      "Bash(git push * +*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin HEAD:main:*)",
      "Bash(git push * *:main)",
      "Bash(git push * *:refs/heads/main)",
      "Bash(git push --tags:*)",
      "Bash(git push --all:*)",
      "Bash(git push --mirror:*)",
      "Bash(git push * --tags*)",
      "Bash(git push * refs/tags/*)",
      "Bash(git push origin v*)",
      "Bash(git push origin --delete:*)",
      "Bash(git push * --delete *)"
    ]
  },
  "env": {
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "350000"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-env.sh\"" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/deny-long-sleep.sh\"" },
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-commands.sh\"" }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-integrator-files.sh\"" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/format-rust.sh\"" }
        ]
      }
    ]
  }
}
