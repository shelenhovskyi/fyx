{
  "compilerOptions": {
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": false,
    "allowJs": true,
    "types": ["node"]
  },
  "include": [
    "fyx-ui-sdk/src/**/*.ts",
    "demo-counter/src/**/*.ts",
    "test/**/*.ts"
  ]
}
